# Configuração de E-mail para SiriusMail
# Copie este arquivo para .env e preencha com suas credenciais

# Gmail IMAP
SIRIUS_EMAIL_USER=seu_email@gmail.com
SIRIUS_EMAIL_PASSWORD=sua_senha_aplicacao_gmail
SIRIUS_IMAP_SERVER=imap.gmail.com
SIRIUS_IMAP_PORT=993

# Para outros provedores:
# Outlook: imap-mail.outlook.com:993
# Yahoo: imap.mail.yahoo.com:993
# Zoho: imap.zoho.com:993

# IMPORTANTE:
# 1. Gmail: Use senha de aplicação (App Password), não sua senha normal
#    - Ative 2FA em sua conta Google
#    - Vá em myaccount.google.com > Segurança > Senhas de app
#    - Gere uma senha de app para "Mail"
#    - Use essa senha aqui

# 2. Proteja este arquivo! NÃO commite no Git
#    - Adicione .env ao .gitignore
#    - Use secrets manager em produção

# 3. Variáveis de ambiente em produção
#    - Docker: use -e SIRIUS_EMAIL_USER=...
#    - Kubernetes: use secrets
#    - Azure: use KeyVault
#    - AWS: use Secrets Manager
